{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@innoica/shared": ["packages/shared/src"],
      "@innoica/shared/*": ["packages/shared/src/*"],
      "@innoica/database": ["packages/database/src"],
      "@innoica/database/*": ["packages/database/src/*"]
    }
  },
  "exclude": ["node_modules"]
}
