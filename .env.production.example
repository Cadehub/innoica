NEXT_PUBLIC_SUPABASE_URL=https://qsyiatlvkyzknawfgpja.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InFzeWlhdGx2a3l6a25hd2ZncGphIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NDYwNTk4MTgsImV4cCI6MjA2MTYzNTgxOH0.t60u_9N155zMv77oN5bE6ZqDdf9qRk99E8B2G3V8K6E
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE

# --- Cryptography & Security ---
# Master key for AES-256-GCM BYOK API key encryption (64 hexadecimal characters = 32 bytes)
# NEVER commit or expose to database/frontend!
ENCRYPTION_MASTER_KEY=4f9c2d1b8e7a3f0c6d5e4b3a2f1e0d9c8b7a6f5e4d3c2b1a0f9e8d7c6b5a4f3e
WORKER_INTERNAL_SECRET=REPLACE_WITH_64_HEX_SECRET

# --- Public App URL (used for Free plan WhatsApp watermark) ---
NEXT_PUBLIC_APP_URL=https://agents.innoica.com

# --- Internal Microservice Endpoints (Docker Network) ---
WHATSAPP_WORKER_URL=http://whatsapp-worker:4001
AI_RUNTIME_URL=http://ai-runtime:4002
INGESTION_WORKER_URL=http://ingestion-worker:4003
SPEECH_WORKER_URL=http://speech-worker:4004

# --- Speech Worker (Voice Message Understanding) ---
SPEECH_WORKER_PORT=4004
WHISPER_MODEL_SIZE=base
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=4
WHISPER_ALLOW_DOWNLOAD=true

# --- Storage & Directories ---
SESSIONS_DIR=/app/sessions

# --- Application Configuration ---
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
DEFAULT_LOCALE=fr
SUPPORTED_LOCALES=fr,en
TIMEZONE=Africa/Douala
DEFAULT_CURRENCY=XAF
