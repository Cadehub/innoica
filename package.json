{
  "name": "innoica-wa-agent-monorepo",
  "version": "2.0.0",
  "private": true,
  "description": "INNOICA WhatsApp Agents SaaS — Turn Complexity Into Simplicity",
  "scripts": {
    "dev": "pnpm --filter innoica-web dev",
    "build": "pnpm -r run build",
    "start": "pnpm --filter innoica-web start",
    "start:wa": "pnpm --filter innoica-whatsapp-worker start",
    "start:ai": "pnpm --filter innoica-ai-runtime start",
    "start:ingestion": "pnpm --filter innoica-ingestion-worker start",
    "start:speech": "python services/speech-worker/app.py",
    "test": "vitest run packages/ services/ apps/ tests/",
    "test:watch": "vitest",
    "lint": "pnpm -r run lint",
    "worker:wa": "pnpm --filter innoica-whatsapp-worker dev",
    "worker:ai": "pnpm --filter innoica-ai-runtime dev",
    "worker:ingestion": "pnpm --filter innoica-ingestion-worker dev"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@11.25.0"
}
